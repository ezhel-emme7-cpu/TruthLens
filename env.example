# Copia este archivo como referencia — en Vercel, estas variables se
# configuran desde el dashboard (Settings → Environment Variables),
# NUNCA se sube un archivo .env real al repositorio de GitHub.

# API key de Anthropic. Vive solo en el servidor. Sácala de:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Planes y límites mensuales ──────────────────────────────────────
# Ningún plan es ilimitado. Cada variant de LemonSqueezy se mapea a un
# límite real. Saca el variant_id desde tu producto en LemonSqueezy
# (Dashboard → producto → variantes → clic en la variante → el ID va
# en la URL). Si no configuras estas variables, TODAS las licencias
# caen al plan por defecto (DEFAULT_PLAN_LIMIT) — así nunca queda un
# hueco sin límite mientras terminas de configurar LemonSqueezy.
PLAN_BASIC_VARIANT_ID=
PLAN_BASIC_NAME=Basic
PLAN_BASIC_LIMIT=300

PLAN_PRO_VARIANT_ID=
PLAN_PRO_NAME=Pro
PLAN_PRO_LIMIT=800

DEFAULT_PLAN_NAME=Plan
DEFAULT_PLAN_LIMIT=150

# ── Código de prueba (opcional, solo para verificar antes de lanzar) ─
# Define un código cualquiera aquí (invéntalo, no viene de LemonSqueezy)
# para poder probar que Claude responde de verdad, sin esperar a tener
# la tienda de LemonSqueezy configurada. Bórralo antes del lanzamiento
# público — cualquiera que conozca el código podría usarlo.
TEST_LICENSE_KEY=
TEST_LICENSE_LIMIT=10

# ── Vercel KV (opcional pero recomendado) ───────────────────────────
# Si conectas el add-on de Vercel KV a este proyecto (Storage → Create
# → KV, desde el dashboard), Vercel agrega estas variables solo —
# no las escribas a mano. Sin ellas, el conteo de uso mensual cae a un
# fallback en memoria que NO es confiable a escala (ver README).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
